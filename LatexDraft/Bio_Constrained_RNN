	\section{Derivation of Log-Normal Quantile on the Simplex}
	\label{appendix:quantile}
	
	This section derives the expression for the quantile $w_q$ of a log-normal weight distribution under the constraint of L1-normalization within a compartment.
	
	\subsection{Log-normal distribution}
	
	Let $w$ be a log-normally distributed random variable:
	\begin{equation}
		w \sim \mathrm{LogNormal}(\mu, \sigma^2),
	\end{equation}
	with quantile function
	\begin{equation}
		w_q = \exp\left(\mu + \sigma \Phi^{-1}(q)\right),
	\end{equation}
	where $\Phi^{-1}(q)$ is the inverse cumulative distribution function of the standard normal distribution.
	
	\subsection{Parameterization via mean and coefficient of variation}
	
	The log-normal parameters can be expressed in terms of the mean $\mu_x = \mathbb{E}[w]$ and coefficient of variation $CV$:
	\begin{equation}
		\mu = \log\left(\frac{\mu_x}{\sqrt{1+CV^2}}\right), 
		\quad
		\sigma = \sqrt{\log(1+CV^2)}.
	\end{equation}
	
	Substituting into the quantile expression yields:
	\begin{align}
		w_q 
		&= \exp\left(
		\log\left(\frac{\mu_x}{\sqrt{1+CV^2}}\right)
		+ \sigma \Phi^{-1}(q)
		\right) \\
		&= \frac{\mu_x}{\sqrt{1+CV^2}} \cdot \exp\left(\sigma \Phi^{-1}(q)\right).
	\end{align}
	
	\subsection{Simplex constraint}
	
	Synaptic weights are L1-normalized within each compartment containing $k_s$ synapses:
	\begin{equation}
		\sum_{j \in k} w_{ij} = 1.
	\end{equation}
	
	The mean weight is therefore
	\begin{equation}
		\mu_x = \frac{1}{k_s}.
	\end{equation}
	
	Define
	\begin{equation}
		c = 1 + CV^2.
	\end{equation}
	
	The quantile becomes
	\begin{equation}
		w_q = \frac{1}{k_s \sqrt{c}} \cdot \exp\left(\sqrt{\log(c)} \, \Phi^{-1}(q)\right).
	\end{equation}
	
	\subsection{Relation to second moment}
	
	Using the definition of the coefficient of variation:
	\begin{equation}
		CV^2 = \frac{\mathbb{E}[w^2]}{\mathbb{E}[w]^2} - 1,
	\end{equation}
	and $\mathbb{E}[w] = 1/k_s$, it follows that
	\begin{equation}
		c = \frac{\mathbb{E}[w^2]}{\mathbb{E}[w]^2}
		= k_s \sum_{j \in k} w_{ij}^2.
	\end{equation}
	
	\subsection{Expression using the complementary error function}
	
	Using the identity
	\begin{equation}
		\Phi^{-1}(q) = -\sqrt{2}\,\mathrm{erfc}^{-1}(2q),
	\end{equation}
	the quantile can be written as
	\begin{equation}
		w_q =
		\frac{1}{k_s \sqrt{c}}
		\exp\left(
		-\sqrt{\log(c)} \, \sqrt{2}\,\mathrm{erfc}^{-1}(2q)
		\right).
	\end{equation}
	
	This provides a closed-form estimate of the target quantile in terms of locally measurable statistics of the synaptic weight distribution.
	
